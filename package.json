{
  "name": "uno-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "typecheck": "tsc -b shared server client",
    "test": "npm run test --workspace shared && npm run test --workspace server",
    "extract-assets": "node tools/extract-assets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "ws": "^8.18.0"
  }
}
